        <mxCell id="p3-1" value="库存与定价 · 两套关联但独立的模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
