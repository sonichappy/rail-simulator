        <mxCell id="p2-29" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;行程与行程段&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户出行方案 / 换乘段&lt;br&gt;运行段引用实际运行实例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
