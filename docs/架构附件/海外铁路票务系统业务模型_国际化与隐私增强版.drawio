        <mxCell id="p10-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p10-4" value="A / 支付接入与路由" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="133" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;付款方式目录&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;银行卡 / 钱包 / 银行转账&lt;br&gt;本地方式 / 现金 / 企业账期" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p10-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;能力与商户规则&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;支持币种、金额、认证与时效&lt;br&gt;授权 / 扣款 / 撤销 / 退款能力" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p10-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;支付适配器&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;创建 / 查询 / 回调验签 / 去重&lt;br&gt;幂等 / 退款 / 对账 / 错误映射" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p10-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;交易与资金记录&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;支付尝试与业务订单分离&lt;br&gt;渠道流水 / 入账 / 清算差异" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p10-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p10-5" target="p10-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p10-6" target="p10-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p10-7" target="p10-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p10-12" value="B / 状态按能力分支，不强制一条直线" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="367" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10-13" value="&lt;b&gt;需要授权的渠道&lt;/b&gt;　创建 → 待用户动作/认证 → 处理中 → 已授权 → 扣款中 → 已扣款；授权可失败、撤销或到期。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="412" width="1520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p10-14" value="&lt;b&gt;直接支付或异步到账&lt;/b&gt;　创建 → 处理中 → 成功 / 失败 / 过期；结果未知先查询；前端跳回页面不构成成功凭据。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="505" width="1520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p10-15" value="C / 与票额保留及恢复策略协同" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="619" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;付款时效与库存期限&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;慢到账方式可能超出锁票期限。&lt;br&gt;产品配置：限制方式、延长保留，&lt;br&gt;或结果确认后重订并处理差价/退款。&lt;br&gt;不可默认所有支付都能即时确认。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="662" width="480" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p10-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;超时、重试与切换渠道&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;未知结果先查询；不要立即再次扣款。&lt;br&gt;路由切换防止两个渠道都成功。&lt;br&gt;服务端校验订单金额及币种。&lt;br&gt;人工现金收款关联班次与交班记录。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="662" width="480" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p10-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;退款、争议与安全&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;退款状态与售后批准状态分开。&lt;br&gt;按能力处理部分退款与原路退回。&lt;br&gt;如有拒付/争议，保留独立处理记录。&lt;br&gt;优先托管支付字段/令牌；业务库不存CVV。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="662" width="480" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p10-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;验收与上线条件&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;重复回调只入账一次；付款成功但出票失败可补偿；退款失败可追踪；不同付款方式通过真实渠道联调。&lt;br&gt;支付方式及认证要求按实际商户合同和适用市场验证；配置开关不代表服务商已开通该能力。参考 [P2]。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="884" width="1520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-11" name="11 语言与界面定制">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p11-1" value="本地化与界面 · 语言、品牌和业务流程独立" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-2" value="同一国家可支持多语言；同一语言可对应多个格式区域。界面可以不同，订单与资金规则保持统一。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p11-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p11-4" value="A / 语言及区域格式" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p11-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;语言资源目录&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;稳定文案键 / 翻译版本 / 审核状态&lt;br&gt;语言标签如 fr-FR、ar；不当作国家&lt;br&gt;界面、票证、通知和条款分别本地化。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p11-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;文字及时间显示&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;复数 / 占位符 / 长文本 / 字体回退&lt;br&gt;RTL方向、双向文本与键盘操作&lt;br&gt;运营日、当地时刻、时区、UTC分开。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p11-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;姓名与表单适配&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;支持不同姓名、地址、电话格式&lt;br&gt;证件和旅客字段按必要性与产品约束&lt;br&gt;非必须信息允许不填，不默认西式姓名。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p11-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;文案回退规则&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户选择 → 市场批准默认语言&lt;br&gt;普通文案可按规则回退；记录缺失&lt;br&gt;必要合同文本缺失时阻止相关产品发布。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p11-9" value="B / UI配置与专用组件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="397" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p11-10" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;品牌主题&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logo / 色彩 / 字体 / 间距&lt;br&gt;Design Tokens与无障碍约束" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="442" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p11-11" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;页面模板&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;桌面 / 移动 / 窗口 / 自助机&lt;br&gt;布局、字段、内容和流程差异" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="442" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p11-12" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;能力驱动组件&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;报价卡 / 选座 / 付款 / 退改&lt;br&gt;特殊交互通过受控组件扩展" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="442" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p11-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;统一业务API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;报价、预订、权益与售后&lt;br&gt;服务端重复校验权限与规则" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="442" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p11-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p11-10" target="p11-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p11-11" target="p11-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p11-12" target="p11-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p11-17" value="C / 定制边界与验收" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="622" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p11-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;允许变化 / 不允许绕过&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;可配置：品牌、布局、文字、字段顺序、支持的业务步骤。&lt;br&gt;可扩展：供应商特殊选座、支付跳转、辅助服务申请组件。&lt;br&gt;不可通过隐藏UI绕过：必需披露、业务校验、权限和数据用途控制。&lt;br&gt;隐私告知与合同条款留存所用版本；新增字段须登记用途。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="740" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p11-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;跨语言与界面测试&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;法语长文案不溢出；阿拉伯语RTL及号码混排正确。&lt;br&gt;座位图保持真实车厢几何与行车方向，不随RTL盲目镜像。&lt;br&gt;跨午夜、夏令时、跨时区运行能清楚展示日期与偏移。&lt;br&gt;用键盘及读屏完成购票；界面更换后报价和订单结果一致。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="665" width="740" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p11-20" value="实现参考：[I1] W3C Language tags；[I2] W3C Structural markup and right-to-left text。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="925" width="1520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p11-21" value="上线前按目标市场确认所需语言、法定文本和适用的无障碍要求；本页未指定国家的强制界面模板。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="958" width="1520" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-12" name="12 GDPR数据保护架构">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p12-1" value="GDPR · 数据保护贯穿业务与基础设施" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p12-2" value="合规能力设计，非合规认证。适用范围按经营与处理活动判断，不能仅以国籍、界面语言或付款币种决定 [G1]。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p12-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    12" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p12-4" value="A / 建议的数据访问路径" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p12-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;用途与责任登记&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;目的 / 字段 / 合法依据 / 保存期&lt;br&gt;控制者、处理者或共同控制者角色" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p12-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;目的及权限控制&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;角色 + 租户 + 目的 + 字段权限&lt;br&gt;同意适用时核对状态与版本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p12-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;旅客隐私资料库&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;个人信息加密 / 密钥隔离&lt;br&gt;业务仅持引用；必要时受控取用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p12-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;最小必要输出&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;出票、客服、运营商按需取字段&lt;br&gt;禁止把完整旅客资料广播到所有域" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p12-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p12-5" target="p12-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p12-6" target="p12-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p12-7" target="p12-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p12-12" value="B / 用途、数据流与基础控制" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p12-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;合法依据与告知 [G2]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;购票履约、法定义务和营销分别评估。&lt;br&gt;同意不是所有处理的统一依据。&lt;br&gt;如依赖同意：可撤回，留存版本与证据。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;特殊类别与最少收集 [G2]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;残疾/健康资料可能涉及特殊类别。&lt;br&gt;须核对Art.6依据及Art.9适用条件。&lt;br&gt;优先资格结果，避免不必要证明影像。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;日志、报表与测试（设计）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;日志去除姓名、证件及支付敏感字段。&lt;br&gt;报表最小化；使用合成测试数据。&lt;br&gt;假名化仍可能是个人数据，不等于匿名。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="410" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;接收方与供应商 [G3]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;登记铁路、支付、云、客服及其角色。&lt;br&gt;处理者协议、分处理者和共享范围。&lt;br&gt;技术接入前完成相应合同与用途核对。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;安全与隔离（设计）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;按风险配置加密、最小权限和访问审计。&lt;br&gt;租户隔离、密钥管理、导出权限及告警。&lt;br&gt;保留期覆盖备份、日志、缓存和分析副本。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="615" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;区域部署与跨境 [G4]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录存储、备份及境外访问的数据流。&lt;br&gt;评估充分性决定、SCC等适用机制。&lt;br&gt;采用SCC时评估接收地风险及补充措施。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="615" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p12-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;设计边界&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;选择欧洲机房不能替代用途、合同、权利和跨境评估；GDPR并非一律禁止数据离开欧洲经济区 [G4]。&lt;br&gt;资料库分离、字段访问与审计是本项目建议方案；实际合规需要持续运行证据。权利及保留流程见第13页。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="865" width="1520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-13" name="13 GDPR权利与运营">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p13-1" value="GDPR · 权利处理、保留删除与事件响应" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p13-2" value="将隐私需求落为可追踪工单与执行任务；由指定责任人判断适用条件、保留例外及通知义务。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p13-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    13" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p13-4" value="A / 数据主体权利请求 [G5]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p13-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;受理与计时&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;访问 / 更正 / 删除 / 限制&lt;br&gt;反对 / 可携带等请求" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p13-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;必要身份核验&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;避免过量补收证件&lt;br&gt;确认请求范围与适用条件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p13-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;检索及执行&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;资料、订单、客服、日志&lt;br&gt;合法保留例外与第三方协调" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p13-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;答复与证据&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;通常一个月内答复；复杂可延两月&lt;br&gt;延长须在首月内告知理由" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p13-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13-5" target="p13-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13-6" target="p13-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13-7" target="p13-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13-12" value="B / 生命周期与删除任务（设计）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p13-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;按用途设置保存期&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;各类数据登记期限、触发点及依据。&lt;br&gt;财务法定保留与营销用途分开。&lt;br&gt;保留例外限制访问，不继续用于营销。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="398" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p13-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;跨系统执行与回执&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;资料库 / 缓存 / 搜索 / 分析 / 供应商&lt;br&gt;删除或匿名化任务可重试、可核对。&lt;br&gt;保留最少执行证据，避免复制被删资料。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="398" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p13-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;备份与恢复控制&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;备份按明确策略隔离并到期清理。&lt;br&gt;恢复后重新应用删除/限制记录。&lt;br&gt;注销账号不代表全部数据可立即删除。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="398" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p13-16" value="C / 个人数据泄露处理 [G6]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="603" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p13-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;识别 → 控制影响 → 风险评估 → 通知判断 → 复盘&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录知悉时间、范围、影响和处置；处理者无不当延迟地通知控制者。&lt;br&gt;控制者应无不当延迟、尽可能在知悉后72小时内向监管机关通报；不太可能造成权利自由风险时可适用例外并留证。&lt;br&gt;可能产生高风险时，应无不当延迟通知受影响个人，除非适用法定例外；不能只等待完整调查后再计时。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="1520" height="150" as="geometry" />
        </mxCell>
