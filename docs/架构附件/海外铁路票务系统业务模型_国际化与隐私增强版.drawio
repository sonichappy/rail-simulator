          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-35" value="关联多次使用事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2-31" target="p2-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-36" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;跨域关联约束&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;预订项 ↔ 库存占用；订单项 ↔ 预订项；乘车权益 ↔ 乘车人及行程覆盖。&lt;br&gt;票证可覆盖多个权益，也可能被新版本替换；不要假定订单、旅客、座位、票证始终一一对应。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
