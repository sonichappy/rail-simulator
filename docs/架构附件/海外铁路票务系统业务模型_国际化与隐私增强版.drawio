        </mxCell>
        <mxCell id="p3-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    03" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-4" value="A / 区间资源与销售配额" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="137" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;物理资源&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运行实例 + 编组版本&lt;br&gt;席位或容量池 + 可用区间" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;销售控制&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;渠道 / 产品 / 区间可售策略&lt;br&gt;预分 / 发布 / 保留用途" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;占用记录&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;临时占用 → 确认或释放&lt;br&gt;记录关联预订与到期时间" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="180" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;可售结果&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;基于资源、占用和销售限制计算&lt;br&gt;查询结果不代表占用成功" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1240" y="180" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-9" value="约束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-5" target="p3-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-10" value="控制受理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-6" target="p3-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-11" value="派生" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-7" target="p3-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-12" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;连续席位反例：同一列车 A → B → C&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;1号座：A—B 空闲，B—C 已售&lt;br&gt;2号座：A—B 已售，B—C 空闲&lt;br&gt;各段余量均为1；要求全程不换座时，A—C可售连续座位为0。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;必须明确的资源约束&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;同席位的重叠区间不得重复确认；所有渠道使用统一占用入口。&lt;br&gt;释放与确认并发时只能产生一个有效结果；重复请求不得重复占用。&lt;br&gt;加减定员或置换先评估已售影响，再生成重排、票证变更及售后任务。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="335" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-14" value="B / 规则 → 报价 → 成交快照" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;定价规则集&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;基础：里程 / 区间 / 产品价（按需）&lt;br&gt;动态：时间 / 余量策略（按需）&lt;br&gt;优惠：身份资格 / 活动 / 渠道补贴" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="576" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;报价计算&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;匹配条件 → 优先级 → 互斥/叠加&lt;br&gt;明确优惠基数、费用项目与承担方&lt;br&gt;输出币种、金额明细、有效期和条件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="570" y="576" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;成交快照&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;保留旅客接受的金额与规则版本&lt;br&gt;含退改条件及费用、优惠分摊&lt;br&gt;后续规则变更不静默重算历史成交" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="576" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p3-18" value="计算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-15" target="p3-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-19" value="接受报价" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3-16" target="p3-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-20" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;产品维度拆分&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;计次票：有效期 / 次数余额 / 预约与核销规则。&lt;br&gt;团体票：共同购买人数 / 名单 / 集体定价与退改约束。&lt;br&gt;席别、产品灵活性、旅客资格、购买群体分别建模。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="776" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3-21" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;尚待定义的业务术语&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;共用 / 复用：明确共享对象、区间、渠道以及冲突规则。&lt;br&gt;原退定义：保留原术语，确认含义后归入定价或售后。&lt;br&gt;罚款：若为乘车违规款项，单独进入补收或处置流程。&lt;br&gt;无坐席上限：统一名称为无座容量上限，并确认适用产品。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="776" width="740" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-4" name="04 购票与状态">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-1" value="购票闭环 · 正常流程与结果不确定分支" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4-2" value="以下采用“先占用、后支付、再确认出票”的示意路径；供应商不支持锁票时，需要配置适配流程。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p4-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    04" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p4-4" value="A / 主流程（自营示例）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="139" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;1 查询行程&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;旅客 / 日期 / 上下车站" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;2 获取报价&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;产品 / 金额 / 条件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;3 创建预订&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;占用资源 / 到期时间" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;4 发起支付&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;订单关联支付尝试" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-9" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;5 确认及出票&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;确认预订 / 签发凭证" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-10" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;6 通知与乘车&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;交付票证 / 验检记录" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="188" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-5" target="p4-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-6" target="p4-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-7" target="p4-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-8" target="p4-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-9" target="p4-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-16" value="B / 关键异常与恢复动作" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;报价变化 / 占用失败&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;重新获取报价并告知变化。&lt;br&gt;未经用户接受，不静默加价扣款。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="403" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;支付失败 / 占用到期&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;关闭待支付路径，释放临时资源。&lt;br&gt;晚到的成功通知进入核查与补偿。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="403" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;支付成功 / 出票结果未知&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;先按业务ID查询，不直接重复出票。&lt;br&gt;确认失败后退款或转人工；记录证据。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="403" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4-20" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;重复回调 / 部分成功&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;按业务幂等键去重与核对状态。&lt;br&gt;多旅客多段：按组合承诺补偿或处理。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="403" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4-21" value="C / 独立状态轨道（示意，不是完整枚举）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="597" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-22" value="&lt;b&gt;预订&lt;/b&gt;　｜　待确认 → 临时占用 → 已确认；失败 / 到期 / 撤销单独表达" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1520" height="69" as="geometry" />
        </mxCell>
        <mxCell id="p4-23" value="&lt;b&gt;支付&lt;/b&gt;　｜　待支付 → 处理中 → 成功或失败；结果未知必须查询确认" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="719" width="1520" height="69" as="geometry" />
        </mxCell>
        <mxCell id="p4-24" value="&lt;b&gt;票证&lt;/b&gt;　｜　待签发 → 有效 → 替换或作废；签发失败不等于支付失败" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="1520" height="69" as="geometry" />
        </mxCell>
        <mxCell id="p4-25" value="&lt;b&gt;订单&lt;/b&gt;　｜　根据订单项、预订、支付及售后聚合展示；保留部分完成状态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="877" width="1520" height="69" as="geometry" />
        </mxCell>
        <mxCell id="p4-26" value="共用要求：请求关联ID · 幂等记录 · 超时任务 · 回调处理 · 状态核对 · 人工接管 · 全程审计" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="1520" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-5" name="05 售后与运营异常">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-1" value="售后与履约 · 退改、运行变更、检票使用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p5-2" value="票证失效、资源释放和资金退款是不同动作；需要明确依赖、恢复策略及最终一致的检查点。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p5-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    05" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-4" value="A / 退票与部分退票" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;选择售后范围&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;旅客 / 订单项 / 行程段" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;生成退票方案&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;原成交条件 / 已用权益&lt;br&gt;应退金额 / 费用 / 时效" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;用户确认方案&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;建立售后单及处理版本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="180" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;执行业务撤销&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;供应或预订确认&lt;br&gt;权益作废 / 资源处理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="970" y="180" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-9" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;退款与核对&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;跟踪支付渠道结果&lt;br&gt;到账记录 / 差异处理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="180" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-5" target="p5-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-6" target="p5-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-7" target="p5-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-8" target="p5-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;改签：关联原权益与新预订&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;计算新方案、可退价值、手续费及补退差额；确定新资源保留和旧权益撤销顺序。&lt;br&gt;新预订失败时保留或恢复旧承诺；禁止“先无条件作废旧票，再尝试购买新票”。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="353" width="1520" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p5-15" value="B / 停运、减编、晚点等运营变更" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="507" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;接收变更&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运行实例 / 编组版本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;计算影响&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;乘客 / 席位 / 联程&lt;br&gt;已购权益与服务承诺" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;形成处置方案&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;重排 / 替代 / 退改&lt;br&gt;明确自动与人工边界" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;实施与通知&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;旅客确认（如需）&lt;br&gt;换票 / 通知 / 工单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="970" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-20" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;闭环核对&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;权益、资源、资金&lt;br&gt;处理记录及遗留异常" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p5-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-16" target="p5-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-17" target="p5-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-18" target="p5-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-19" target="p5-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-25" value="C / 验检票与权益使用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="726" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-26" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;在线验检&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;验证票证真实性、有效范围及当前版本。&lt;br&gt;区分进站、出站、车上查验与计次核销。&lt;br&gt;按规则记录使用，不把每次扫码都视为整票消耗。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="480" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p5-27" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;离线能力（按目标设备确认）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;本地可验证范围 / 数据版本 / 同步时间。&lt;br&gt;定义作废信息延迟及重复使用风险处置。&lt;br&gt;恢复联网后上传事件并核对冲突。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="770" width="480" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p5-28" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;恢复与人工处理&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;退款失败：重试、查询、人工对账。&lt;br&gt;换票后：原票与新票关联，避免双重有效。&lt;br&gt;通知失败：补发并记录，不改变票务事实。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="770" width="480" height="185" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-6" name="06 边界与实施顺序">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-1" value="边界与实施顺序 · 把未决问题显式留在图中" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6-2" value="尚未确认：经营角色、目标国家与运营商、首期产品范围，以及原图中的部分业务术语。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p6-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    06" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p6-4" value="A / 权威状态归属（建议；按经营模式确认）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;运行与运力&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;自营：运行计划及运力管理维护。&lt;br&gt;外部：供应方数据为依据，保留来源与版本。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="182" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;价格与库存&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;自营：定价及库存域最终受理。&lt;br&gt;外部：报价、占用和确认遵循供应方能力。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="182" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;订单与资金&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;本系统维护客户订单；外部预订保留映射。&lt;br&gt;支付渠道结果与本地资金账核对，保留差异。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="182" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;票证与使用&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;发行方维护有效性，检票方记录使用事件。&lt;br&gt;跨系统约定同步、作废、替换及冲突处理。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="182" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6-9" value="B / 实施优先级" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="372" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-10" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;P0 · 平台与市场基础&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;确认经营边界、核心对象与交易状态。&lt;br&gt;建立配置版本、货币、语言与支付接口。&lt;br&gt;确定隐私用途、权限、保留与数据流。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="415" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p6-11" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;P1 · 铁路最小闭环&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;单一明确产品：查询到检票与退票。&lt;br&gt;实现幂等、超时、查询核对和人工恢复。&lt;br&gt;覆盖并发与资金异常，并完成隐私演练。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="415" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p6-12" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;P2 · 按市场扩展&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;新增市场、多运营商、换乘及复杂退改。&lt;br&gt;计次、团体、动态定价及渠道经营。&lt;br&gt;成熟后扩展酒店、机票等其他品类。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="415" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p6-13" value="C / 必须走通的五个验收场景" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;业务一致性场景&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 窗口与App抢最后一个连续可用席位：只确认一次。&lt;br&gt;② 锁票到期与支付成功同时发生：核查后完成或补偿。&lt;br&gt;③ 三人订单退一人：其余人的票证、价格和权益仍正确。&lt;br&gt;④ 减编导致已售席位不存在：受影响旅客进入处置闭环。&lt;br&gt;⑤ 退票后离线设备仍持旧票信息：按定义的离线策略处置。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="900" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p6-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;市场适配待确认&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;车次绑定 / 强制订座 / 开放日期产品。&lt;br&gt;运营日 / 跨午夜 / 时区。&lt;br&gt;旅客优惠资格 / 名单与证件要求。&lt;br&gt;币种 / 舍入 / 票证介质 / 售后能力。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="980" y="665" width="580" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p6-16" value="参考：OSDM 的产品、报价、乘车权利与订座职责划分；不代表本项目已决定采用该标准。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="919" width="1520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p6-17" value="https://osdm.io/spec/models/   ·   https://osdm.io/spec/roles/   ·   国际化与隐私专题见07–13页；原始草图位于14页" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=13;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1520" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-7" name="07 多市场配置与扩展">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7-1" value="多市场平台 · 配置、规则与适配职责" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p7-2" value="新增设计建议：稳定票务核心 + 可版本化业务配置 + 有边界的策略扩展 + 供应商与支付适配。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p7-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    07" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p7-4" value="A / 上下文先拆开，避免一个 country 字段决定所有行为" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p7-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;经营与销售&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;租户 / 销售法人 / 商户账号&lt;br&gt;销售市场 / 品牌 / 渠道" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p7-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;铁路供给&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运营商 / 运行段 / 产品 / 票价提供方&lt;br&gt;跨境行程逐段识别供应规则" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p7-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;用户偏好&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;界面语言 / 格式区域 / 显示币种&lt;br&gt;时区与无障碍偏好独立保存" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p7-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;数据处理&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;处理目的 / 主体 / 适用法域&lt;br&gt;存储区与接收方；由政策登记确定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p7-9" value="B / 受约束的配置解析与发布" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="356" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p7-10" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;配置来源&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;平台默认 / 市场 / 运营商&lt;br&gt;产品 / 品牌 / 渠道差异" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="404" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p7-11" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;策略解析器&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;按字段定义优先级与合并规则&lt;br&gt;法域与供应硬约束独立校验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="404" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p7-12" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;发布的配置版本&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;结构校验 / 冲突检测 / 回归&lt;br&gt;审批 / 生效期 / 灰度 / 回滚" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="404" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p7-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;业务执行上下文&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;报价、订单记录配置与规则版本&lt;br&gt;服务端校验；UI按能力展示" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="404" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p7-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7-10" target="p7-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7-11" target="p7-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7-12" target="p7-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7-17" value="C / 三种扩展方式及其边界" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="592" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p7-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;参数与数据配置&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;等级字典 / 年龄条件 / 价格表 / 文案&lt;br&gt;主题令牌 / 字段显示 / 支付方式开关&lt;br&gt;适合结构不变、取值不同的需求。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="635" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p7-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;版本化策略扩展&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;定价 / 配额 / 配座 / 售后计算&lt;br&gt;声明输入输出、版本和失败行为&lt;br&gt;受控执行，不允许运营后台注入任意代码。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="635" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p7-20" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;外部协议适配&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;铁路 / 支付 / 税票 / 票证 / 检票&lt;br&gt;能力清单、错误映射、幂等与结果查询&lt;br&gt;外部不可用时不得虚构成功或能力。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="635" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p7-21" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;不可覆盖的业务约束&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;国家、品牌和UI配置不得关闭：重叠区间防超售、资金核对、授权检查、隐私访问控制与审计。&lt;br&gt;“更具体配置”并非总是优先：跨境法域冲突进入审核；供应方不支持的选座、退款等能力不得自行开启。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C56B64;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="841" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p7-22" value="验收：同一旅客可用法语界面、美元展示、欧元付款；切换语言不应改变已接受的价格与合同。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="1520" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-8" name="08 席位等级与选座">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8-1" value="席位产品与选座 · 等级、空间和偏好分离" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p8-2" value="不建立跨运营商强制通用的“一等 / 二等”枚举；保留原始定义，另设可选的展示与搜索映射。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p8-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    08" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p8-4" value="A / 可扩展的席位模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p8-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;服务等级 ServiceClass&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运营商作用域ID / 原始编码&lt;br&gt;多语言名称 / 权益 / 本地排序&lt;br&gt;跨运营商映射允许“不完全可比”。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p8-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;住宿类型 Accommodation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;座椅 / 卧铺 / 包厢 / 其他类型&lt;br&gt;售卖单位：席位、床位或整间&lt;br&gt;包厢与内部床位声明互斥资源关系。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p8-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;席位特征与限制&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;窗 / 过道 / 桌位 / 安静区 / 方向&lt;br&gt;轮椅空间 / 同行 / 相邻 / 可用设施&lt;br&gt;资格限制、收费属性与普通偏好分离。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p8-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;编组与座位图版本&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;车厢顺序 / 楼层 / 席位ID / 坐标&lt;br&gt;资源ID稳定映射；显示号码可不同&lt;br&gt;检修或换编组后重新校验分配结果。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p8-9" value="B / 选座能力不是所有产品都相同" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="401" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p8-10" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;无选座 / 自动配座&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;无指定席产品：仅确认乘车权益。&lt;br&gt;自动配座：系统给出最终分配。&lt;br&gt;不展示供应方不支持的座位选择。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p8-11" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;偏好申请&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;靠窗 / 同行相邻等作为软偏好。&lt;br&gt;明确是否保证、是否额外收费。&lt;br&gt;不满足时提示，不将偏好当作承诺。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="445" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p8-12" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;图形选座 / 指定席位&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;座位图查询 → 临时占用 → 确认。&lt;br&gt;座位图显示空闲不代表锁定成功。&lt;br&gt;硬条件失败需重新选择或明确降级。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="445" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p8-13" value="C / 配座与供应能力检查" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="651" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p8-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;识别能力&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运营商 × 产品 × 渠道&lt;br&gt;无 / 自动 / 偏好 / 指定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p8-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;匹配约束&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;人数 / 区间连续 / 资格&lt;br&gt;软偏好与硬条件分开" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="695" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p8-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;原子占用&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;关联座位图与编组版本&lt;br&gt;资源争用时返回失败" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="695" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p8-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;确认与变更&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录实际席位及承诺&lt;br&gt;置换 / 补退差 / 通知" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="695" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p8-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8-14" target="p8-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8-15" target="p8-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8-16" target="p8-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8-21" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;验收与参考&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;验收：整包厢与内部床位不能重复售出；同行不能相邻时按约定处理；跨区间连续席位不足时不得误售。&lt;br&gt;参考 [R1] OSDM 的乘车权利与订座分离；上述等级、布局和能力配置为本项目建议设计。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="874" width="1520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-9" name="09 票价规则与币种">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9-1" value="票价与金额 · 可解释规则、不可变成交记录" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1500" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p9-2" value="不同运营商的计算方式可并存；Money 必须同时包含金额与币种，禁止以浮点数直接计算财务金额。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=15;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1515" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p9-3" value="海外铁路票务系统  /  业务设计工作稿 v3  /  2026-09-16    ·    09" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=12;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p9-4" value="A / 票价策略管线（顺序由版本化策略明确）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="134" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p9-5" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;规则匹配&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;运营商 / 区间 / 产品 / 旅客&lt;br&gt;销售市场 / 时间 / 渠道" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p9-6" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;基础与动态计算&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;里程 / 区间 / 分区 / 产品价&lt;br&gt;时段、库存梯度、收益策略" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p9-7" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;优惠、费用及税费&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;互斥 / 叠加 / 优先级 / 上限&lt;br&gt;基数、承担方、适用税费" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p9-8" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;报价与规则快照&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;明细 / 币种 / 条件 / 到期时间&lt;br&gt;命中规则、版本、舍入轨迹" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p9-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9-5" target="p9-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9-6" target="p9-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#66809C;strokeWidth=2;fontColor=#334A62;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9-7" target="p9-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9-12" value="B / 四种金额角色分别建模" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="378" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p9-13" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;产品计价币种&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;票价提供方的原始报价。&lt;br&gt;保留来源金额和原始费用明细。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p9-14" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;展示币种&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;面向用户的换算展示。&lt;br&gt;注明估算性质或明确锁价条件。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4F8;strokeColor=#8B9BAD;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="424" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p9-15" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;支付币种&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户确认并实际扣款的币种。&lt;br&gt;确认页明确金额、费用与汇率条件。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="424" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p9-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;结算币种&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;与支付方、铁路方核对的币种。&lt;br&gt;分别记录结算汇率、费用及差额。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="424" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p9-17" value="C / 金额计算及退款规则" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=19;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="593" width="1510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p9-18" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;金额与汇率模型&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;定点小数 / 最小货币单位；币种精度与舍入规则有版本。&lt;br&gt;汇率来源、时间、方向、有效期、加点或费用分别记录。&lt;br&gt;渠道API金额精度可与标准不同，在适配层转换并验证 [P1]。&lt;br&gt;跨币种不直接相加；各金额角色分别出具合计。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4477B8;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="637" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p9-19" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;成交、分摊与退款&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;订单项 / 旅客 / 行程段保留费用和优惠分摊及尾差处理。&lt;br&gt;退款依据成交条件及支付币种约定，不按当前展示价重算。&lt;br&gt;记录退款、供应退款、汇兑差额；是否原路退由渠道能力决定。&lt;br&gt;法定调整以独立事件处理，不静默改写历史成交。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="637" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p9-20" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;验收场景&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;零位、两位、三位小数币种；不同渠道精度；组合优惠顺序；报价过期；部分退票的分摊及尾差守恒。&lt;br&gt;来源 [P1] Adyen Currency codes and minor units（仅作为支付适配差异示例，未选定支付服务商）。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#C98B32;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="867" width="1520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-10" name="10 支付方式与状态">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p10-1" value="支付编排 · 支持不同渠道能力与到账时序" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDD6E0;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;fillColor=none;strokeColor=none;spacing=0;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
