        <mxCell id="p2-16" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;报价与报价项&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;面向乘客及行程的金额与条件&lt;br&gt;有效期 / 币种 / 规则版本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
