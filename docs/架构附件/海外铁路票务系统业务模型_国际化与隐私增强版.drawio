        <mxCell id="p2-17" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;预订与预订项&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;接受的报价快照 / 供应来源&lt;br&gt;占用、确认、撤销结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#8763B2;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
