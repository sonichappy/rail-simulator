        <mxCell id="p2-30" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;订座记录（如需）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;对应乘客、运行段和占用资源&lt;br&gt;可与乘车权利分开或组合销售" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F5F1;strokeColor=#2F8878;fontColor=#20334A;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=14;shadow=0;" vertex="1" parent="1">
