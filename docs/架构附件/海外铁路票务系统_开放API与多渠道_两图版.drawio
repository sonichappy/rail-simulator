        <mxCell id="n2-10" value="&lt;b&gt;身份与数据范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;校验租户、渠道与订单归属&lt;br&gt;限制可售产品与可见旅客字段" vertex="1" parent="n2-9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;spacing=11;fontSize=16;">
