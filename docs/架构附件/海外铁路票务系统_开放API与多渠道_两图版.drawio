        </mxCell>
        <mxCell id="n2-4" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;API 管理与监控模块&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;注册客户应用与绑定所属渠道&lt;br&gt;管理凭证轮换、撤销与接口权限&lt;br&gt;发布文档、沙箱、版本与下线计划&lt;br&gt;配置调用配额与发布网关策略&lt;br&gt;监控错误率、延迟与调用审计" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
