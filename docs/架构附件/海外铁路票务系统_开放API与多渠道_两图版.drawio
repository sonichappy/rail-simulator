        <mxCell id="n2-14" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;API 调用额度&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;配置每应用的频率与调用次数&lt;br&gt;执行网关限流与统计调用用量&lt;br&gt;保护接口容量与限制异常流量" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
