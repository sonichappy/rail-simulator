        <mxCell id="n2-11" value="&lt;b&gt;请求与结果语义&lt;/b&gt;&lt;br&gt;&lt;br&gt;按渠道和请求标识保证幂等&lt;br&gt;查询超时结果与返回明确错误" vertex="1" parent="n2-9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;spacing=11;fontSize=16;">
