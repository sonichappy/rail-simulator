        <mxCell id="n2-17" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;运维中心与 API 监控协同&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;监测应用调用、接口质量与通知投递（API 中心）&lt;br&gt;关联订单、库存、任务与基础设施告警（运维中心）&lt;br&gt;执行受控重试与业务修复，保留授权及操作记录" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D2A15C;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
