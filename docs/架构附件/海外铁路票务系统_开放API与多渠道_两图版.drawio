        </mxCell>
        <mxCell id="n2-5" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;API 网关模块&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;校验访问凭证与执行接口授权&lt;br&gt;绑定可信租户、应用与渠道身份&lt;br&gt;限制频率、并发与请求体大小&lt;br&gt;路由请求与贯通关联追踪标识&lt;br&gt;过滤敏感日志与拒绝失效凭证" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#608AC3;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
