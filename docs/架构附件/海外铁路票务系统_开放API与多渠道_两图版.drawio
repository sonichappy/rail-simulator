        </mxCell>
        <mxCell id="n2-18" value="身份校验不能替代订单归属校验；调用额度、库存额度与资金授信分别执行。监控展示允许延迟，实际交易按权威状态校验。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;">
