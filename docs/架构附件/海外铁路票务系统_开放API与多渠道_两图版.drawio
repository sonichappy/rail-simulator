        <mxCell id="n2-15" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;渠道库存额度&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;配置渠道上限或独占配额（三方）&lt;br&gt;联动校验额度与席位占用（核心）&lt;br&gt;确认区间占用与释放、回收资源" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#608AC3;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
