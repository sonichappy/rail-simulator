          <mxGeometry x="48" y="159" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-5" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;后台：余票计算与同步&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;预售初始化 / 定时校准与重建&lt;br&gt;交易变更事件驱动增量计算&lt;br&gt;版本、水位、去重与失败重放" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D2A15C;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="660" y="159" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-6" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;后台：余票库 / 查询投影&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;按车次、区间、席别等提供查询&lt;br&gt;记录更新时间及计算版本&lt;br&gt;不由Web直接扣减，不作为最终承诺" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D2A15C;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="1272" y="159" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-7" value="" edge="1" parent="1" source="n2-4" target="n2-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-8" value="" edge="1" parent="1" source="n2-5" target="n2-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-9" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;后台：票务核心交易服务&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;校验可售条件 / 原子锁定 / 配座&lt;br&gt;预订确认 / 出票 / 到期与取消释放&lt;br&gt;统一处理区间冲突及重复请求" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#608AC3;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="48" y="426" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-10" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;Web：订单与支付编排&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;锁票 → 支付 → 确认出票或补偿&lt;br&gt;销售订单号 ↔ 核心预订号&lt;br&gt;超时结果未知：按请求号核查" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#9B80BD;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="660" y="426" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-11" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;Web：余票查询与选购&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;通过余票接口读取快速查询结果&lt;br&gt;展示席别、条件、价格和选座能力&lt;br&gt;查询有票不代表已完成资源占用" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#9B80BD;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="1272" y="426" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n2-12" value="事务性占用与状态更新" edge="1" parent="1" source="n2-9" target="n2-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-13" value="只读查询" edge="1" parent="1" source="n2-11" target="n2-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-14" value="提交购买" edge="1" parent="1" source="n2-11" target="n2-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-15" value="预订命令 / 结果" edge="1" parent="1" source="n2-10" target="n2-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7890AA;endArrow=block;endFill=1;fontSize=13;fontColor=#536980;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;startArrow=block;startFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-16" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;占用与确认语义&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;锁定即占资源，不能等待支付后才扣。&lt;br&gt;确认将锁定转为已售，不重复消耗。&lt;br&gt;到期或撤销只释放一次；退票按确认结果处理。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#579A88;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="48" y="650" width="540" height="168" as="geometry" />
        </mxCell>
        <mxCell id="n2-17" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;计算任务的职责&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;定时任务负责初始化、校准与重建。&lt;br&gt;交易后刷新受影响区间；乱序和重复可恢复。&lt;br&gt;重建按一致快照及增量水位切换，避免覆盖新状态。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D2A15C;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="630" y="650" width="540" height="168" as="geometry" />
        </mxCell>
        <mxCell id="n2-18" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;备选：Web独占销售配额&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心先划出实际可兑现、互不重售的资源。&lt;br&gt;Web维护配额占用账，协调发放、回收与核对。&lt;br&gt;这不是查询缓存；不能靠定时覆盖余额补库存。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="1212" y="650" width="540" height="168" as="geometry" />
        </mxCell>
        <mxCell id="n2-19" value="&lt;b&gt;运维中心 · 重点管理两系统和库存数据链路&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#9AAABA;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;fontSize=19;spacing=0;spacingLeft=17;spacingTop=12;">
          <mxGeometry x="48" y="878" width="1704" height="226" as="geometry" />
        </mxCell>
        <mxCell id="n2-20" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;观测与定位&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;余票更新时间 / 计算与消息延迟&lt;br&gt;锁票失败率 / 出票成功率 / 未决交易&lt;br&gt;库存、预订、支付差异与关联追踪" vertex="1" parent="n2-19" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="24" y="55" width="534" height="151" as="geometry" />
        </mxCell>
        <mxCell id="n2-21" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;任务与业务恢复&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;调度、重试、重放和对账任务&lt;br&gt;经授权修复；不直接手改库存余额&lt;br&gt;支付已成功但出票未知进入恢复工单" vertex="1" parent="n2-19" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="582" y="55" width="534" height="151" as="geometry" />
        </mxCell>
        <mxCell id="n2-22" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;可用性与安全&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;核心不可用：禁止绕过核心承诺席位&lt;br&gt;余票过期：降级展示、校验或限流&lt;br&gt;发布回滚 / 容灾演练 / 权限审计 / 日志脱敏" vertex="1" parent="n2-19" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;">
          <mxGeometry x="1140" y="55" width="534" height="151" as="geometry" />
        </mxCell>
        <mxCell id="n2-23" value="建议实现：可靠变更记录（如Outbox/CDC）+ 幂等计算 + 定时核对；技术选型及刷新频率按实际规模确定。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;fillColor=none;strokeColor=none;spacing=0;fontSize=14;fontStyle=0;verticalAlign=middle;">
          <mxGeometry x="48" y="1118" width="1704" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
