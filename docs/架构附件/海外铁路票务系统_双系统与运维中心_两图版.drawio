        </mxCell>
        <mxCell id="n2-2" value="主方案：余票库是查询投影；订单通过后台核心锁定与确认资源。查询允许短暂滞后，实际占用不得超售。" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2DE;fontColor=#23384E;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=17;fillColor=none;strokeColor=none;spacing=0;fontSize=16;fontStyle=0;verticalAlign=middle;">
